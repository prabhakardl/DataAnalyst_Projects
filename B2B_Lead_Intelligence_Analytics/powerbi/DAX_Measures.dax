Total Leads = COUNTROWS(Leads)
Qualified Leads = CALCULATE([Total Leads], Leads[lead_status] IN {"Qualified","Hot","Priority"})
Emails Sent = COUNTROWS(Campaigns)
Delivered Emails = CALCULATE([Emails Sent], Campaigns[delivery_status] = "Delivered")
Total Opens = SUM(Campaigns[opened])
Total Replies = SUM(Campaigns[replied])
Delivery Rate = DIVIDE([Delivered Emails], [Emails Sent], 0)
Open Rate = DIVIDE([Total Opens], [Delivered Emails], 0)
Reply Rate = DIVIDE([Total Replies], [Delivered Emails], 0)
High Priority Leads = CALCULATE([Total Leads], Leads[lead_score] >= 85)
